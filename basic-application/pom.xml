<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.iglooproject.parents</groupId>
    <artifactId>igloo-parent-core-project</artifactId>
    <version>${revision}</version>
    <relativePath>../igloo/igloo-parents/igloo-parent-core-project/pom.xml</relativePath>
  </parent>
  <groupId>org.iglooproject.archetype</groupId>
  <artifactId>basic-application</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>Basic Application</name>
  <modules>
    <module>basic-application-back</module>
    <module>basic-application-front</module>
    <module>basic-application-app</module>
    <module>basic-application-static</module>
  </modules>
  <properties>
    <versionPlaceholderDoNotRemove/>
    <!-- restrict jacoco instrumentation to application classes -->
    <igloo.jacoco.include>basicapp.*</igloo.jacoco.include>
  </properties>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <configuration>
            <skip>true</skip>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <!-- configured in igloo-maven plugins-jacoco: prepare-agent + report (target/site/jacoco) on package -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-site</id>
            <configuration>
              <!-- report includes are class file paths (basicapp/**), not class names (basicapp.*) used by the agent ;
                   module classes are all application classes, so include everything -->
              <includes combine.self="override">
                <include>**/*</include>
              </includes>
              <!-- bindgen generated classes (jakarta @Generated has SOURCE retention, so jacoco cannot filter them) -->
              <excludes>
                <exclude>**/*Binding.class</exclude>
                <exclude>**/*BindingPath.class</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <scm>
    <developerConnection>scm:git:git@gitlab.tools.kobalt.fr:kobalt/${projectName}.git</developerConnection>
    <url>https://gitlab.tools.kobalt.fr/kobalt/${projectName}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitLab</system>
    <url>https://gitlab.tools.kobalt.fr/kobalt/${projectName}/issues</url>
  </issueManagement>
  <ciManagement>
    <system>GitLab</system>
    <url>https://gitlab.tools.kobalt.fr/kobalt/${projectName}/pipelines</url>
  </ciManagement>
  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>nexus-igloo-releases</id>
      <name>Nexus Igloo Releases</name>
      <url>https://nexus.tools.kobalt.fr/repository/igloo-releases/</url>
    </repository>
    <repository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>nexus-igloo-snapshots</id>
      <name>Nexus Igloo Snapshots</name>
      <url>https://nexus.tools.kobalt.fr/repository/igloo-snapshots/</url>
    </repository>
  </repositories>
</project>
